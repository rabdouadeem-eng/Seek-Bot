# اختيار المصدر: binance أو yahoo
DATA_SOURCE=yahoo

# إذا اخترت yahoo، استخدم هذه الرموز:
SYMBOL_YAHOO=XAUUSD=X
# أو للفوركس: EURUSD=X، GBPUSD=X

# إذا اخترت binance، استخدم هذا:
SYMBOL=BTCUSDT

# باقي الإعدادات
TIMEFRAME=15m
LOOKBACK_CANDLES=20
RISK_PER_TRADE=0.02
MAX_TRADES_PER_DAY=5
INITIAL_BALANCE=10000
MIN_CONFIDENCE=0.6
